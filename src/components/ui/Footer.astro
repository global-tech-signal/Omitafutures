---
import { Image } from "astro:assets";
import Facebook from "../../assets/facebook.svg";
import Linkedin from "../../assets/linkedin.svg";
import Logo from "../../assets/logo-alt.svg";
import Twitter from "../../assets/twitter.svg";
import ShortForm from "../ui/ShortForm.astro";

const logos = [
  { name: "Linkedin", src: Linkedin, link: "https://www.linkedin.com/company/global-tech-signal" },
];

const links = [
  { name: "News", href: "/articles" },
  { name: "Case Studies", href: "/#case-studies" },
  { name: "Services", href: "/services" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
];
---

<section class="sm:px-5">
  <div class="w-full max-w-[1240px] mx-auto">
    <div
      class="px-[15px] bg-dark text-gray py-[55px] lg:px-[60px] sm:rounded-t-[45px]"
    >
      <div>
        <div
          class="flex flex-col lg:flex-row gap-7 items-center justify-between"
        >
          <ul class="flex flex-col sm:flex-row gap-5">
            {
              links.map((link) => {
                return (
                  <li class="text-center">
                    <a class="underline" href={link.href}>
                      {link.name}
                    </a>
                  </li>
                );
              })
            }
          </ul>
          <ul class="flex gap-5">
            {
              logos.map((logo) => {
                return (
                  <li>
                    <a href={logo.link} target="_blank">
                      <picture>
                        <Image src={logo.src} alt={logo.name} />
                      </picture>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="flex flex-col lg:flex-row mt-[66px] mb-[51px]">
          <div
            class="flex text-center lg:text-start flex-col w-full lg:w-[30%]"
          >
            <h3 class="mb-5 text-center md:text-left text-2xl text-red">OMITA FUTURES PVT LTD</h3>
            <p class="text-sm tracking-widest mb-4 text-gray/70">INNOVATING | DELIVERING | GROWING</p>
            <div class="flex flex-col justify-between gap-3 text-sm">
              <span>CIN No.: U63120HR2026PTC144889</span>
              <span>Unit No. 309, 3rd Floor, Tower-A, SAS Tower, Sector-38, Gurugram-122001, Haryana</span>
              <span>Mobile: <a href="tel:9988550109" class="underline">9988550109</a></span>
              <span>Email: <a href="mailto:omitafutures@gmail.com" class="underline">omitafutures@gmail.com</a></span>
            </div>
          </div>
          <div class="flex-grow my-10 lg:my-0 lg:ml-12">
            <ShortForm />
          </div>
        </div>
      </div>

      <div class="h-[1px] bg-gray mb-5"></div>
      <div
        class="flex flex-col lg:flex-row h-20 justify-center mt-4 text-center md:justify-between md:mt-0"
      >
        <span
          >© 2026 Omita Futures Pvt Ltd — Global Tech News, Insights & Engineering.</span
        >
      </div>
    </div>
  </div>
</section>
